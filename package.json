{
  "name": "atomic-photographer",
  "version": "0.1.0",
  "description": "A web app for producing consistent image exports for the web, with a Headshot Formatter and a Meta Image Generator.",
  "author": "Alecia Frederick",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"./.venv/bin/python -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 8000\" \"vite\"",
    "dev:web": "npm run dev",
    "dev:api": "./.venv/bin/python -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "preview": "./.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "start": "python3 -m uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-8000}"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
